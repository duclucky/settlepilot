{
  "name": "tameion-contractor-operator",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:decision": "tsx scripts/verify-decision-record.ts",
    "eval:liquidity": "tsx scripts/evaluate-liquidity.ts --live",
    "start": "tsx src/server.ts",
    "check:arc": "tsx src/check-arc.ts",
    "check:ai": "tsx src/check-ai.ts",
    "audit:50": "tsx src/audit/run-50.ts",
    "audit:verify": "tsx src/audit/verify-run.ts",
    "audit:autonomous": "tsx src/audit/run-autonomous.ts",
    "audit:autonomous:verify": "tsx src/audit/verify-autonomous.ts"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "10.8.1",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}

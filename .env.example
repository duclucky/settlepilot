# Copy to .env and edit locally. Never paste secrets into chat.
TAMEION_MODE=simulation
WALLET_PROVIDER=agent
# For an existing Circle Agent Wallet session use WALLET_PROVIDER=agent.
# Agent payments use Circle-sponsored gas. Keep sending false until the policy scope is authorized.
# CIRCLE_CLI_ENTRYPOINT=C:/path/to/node_modules/@circle-fin/cli/dist/index.js
PORT=4317
SEND_ENABLED=false
BRIDGE_ENABLED=false
ALLOW_MODEL_REQUESTS=false
# Real AI planning. API keys stay only in this ignored local file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.4-mini
JEV_ENABLED=false
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.80
# Outbound-only Telegram alerts. The app never reads Telegram messages or accepts Telegram commands.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Arc/Circle testnet only. User generates/registers their entity secret.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AVAX_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MATIC_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
UNI_SEPOLIA_RPC_URL=https://sepolia.unichain.org
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
POLICY_FILE=data/policy.json
# DATABASE_PATH=data/simulation.db

# Shared primary LLM + reviewer limits; estimated nano-USD, not USDC.
LLM_MAX_RUN_REQUESTS=40
LLM_MAX_DAY_REQUESTS=120
LLM_MAX_RUN_TOKENS=250000
LLM_MAX_DAY_TOKENS=500000
LLM_MAX_RUN_COST_NANO_USD=500000000
LLM_MAX_DAY_COST_NANO_USD=1000000000
